# ── LLM Provider (OpenAI-compatible) ─────────────────────────────────────────
LLM_API_KEY=your-api-key-here        # required — NVIDIA NIM / OpenAI / Together etc.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1  # remove for default OpenAI endpoint

# ── LLM Models ────────────────────────────────────────────────────────────────
PLANNER_MODEL=deepseek-ai/deepseek-r1-0528-qwen3-8b
COMBINER_MODEL=deepseek-ai/deepseek-r1-0528-qwen3-8b
AGENT_MODEL=deepseek-ai/deepseek-r1-0528-qwen3-8b

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb                    # docker-compose service name
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=hr_documents

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5  # 335M params — highest BGE accuracy

# ── Retrieval ─────────────────────────────────────────────────────────────────
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=8
RRF_K=60

# ── SQL Agent ─────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=/app/data/hr_database.sqlite
SQL_MAX_ROWS=100

# ── Memory ────────────────────────────────────────────────────────────────────
SUMMARY_EVERY_N_TURNS=10
RECENT_TURNS_TO_KEEP=3

# ── Context Token Budgets ─────────────────────────────────────────────────────
MAX_SYSTEM_PROMPT_TOKENS=1000
MAX_SUMMARY_TOKENS=600
MAX_RECENT_TURNS_TOKENS=800
MAX_AGENT_CONTEXT_TOKENS=1000

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=20
UPLOAD_TTL_HOURS=1

# ── Paths ─────────────────────────────────────────────────────────────────────
HR_DOCS_PATH=/app/data/hr_documents

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
